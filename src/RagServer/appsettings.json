{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5077",
  "ConnectionStrings": {
    "Rag": "Host=localhost;Port=5432;Database=rag;Username=rag;Password=rag"
  },
  "Rag": {
    "OllamaUrl": "http://10.10.10.2:11434",
    "EmbeddingModel": "nomic-embed-text",
    "EmbeddingBatchSize": 32,
    "ChunkTargetChars": 1200,
    "ChunkMaxChars": 1800,
    "ChunkOverlapChars": 150,
    "FilesDirectory": "../../data/files",
    "Ocr": {
      "Enabled": true,
      "Model": "glm-ocr",
      "Prompt": "Text Recognition:",
      "Dpi": 150,
      "MaxImageEdge": 1800,
      "PageTimeoutSeconds": 300,
      "KeepAlive": "5m",
      "MaxPages": 500,
      "AutoOnImport": false
    }
  }
}
